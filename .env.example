# Environment Variables Configuration

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (Backend) - REQUIRED
# Format: sk_test_... (test mode) or sk_live_... (production)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Secret - REQUIRED
# Get this from: https://dashboard.stripe.com/webhooks
# After creating webhook endpoint, copy the signing secret
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here


# ============================================
# EMAIL CONFIGURATION (NODEMAILER + GMAIL)
# ============================================

# Gmail Account - REQUIRED
# Your Gmail address that will send order confirmation emails
GMAIL_USER=your-email@gmail.com

# Gmail App Password - REQUIRED
# NOT your regular Gmail password!
# Generate at: https://myaccount.google.com/apppasswords
# Steps:
#   1. Go to Google Account → Security
#   2. Enable 2-Step Verification (if not already enabled)
#   3. Go to App Passwords
#   4. Select "Mail" and "Other (Custom name)"
#   5. Copy the 16-character password
GMAIL_APP_PASSWORD=your_16_character_app_password


# ============================================
# FRONTEND CONFIGURATION (VITE)
# ============================================
# These are exposed to the browser (prefix with VITE_)

# Stripe Publishable Key (Frontend) - REQUIRED
# Format: pk_test_... (test mode) or pk_live_... (production)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Gemini API Key (if using AI features)
GEMINI_API_KEY=your_gemini_api_key_here
